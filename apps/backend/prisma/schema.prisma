  tenantId           String
  machineId          String
  fromState          MachineMaintenanceState
  toState            MachineMaintenanceState
  reason             String
  maintenanceOrderId String?
  breakdownId        String?
  actorId            String
  occurredAt         DateTime                @default(now())
  machine            Machine                 @relation(fields: [machineId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actor              User                    @relation(fields: [actorId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, machineId, occurredAt])
}

model ReturnToServiceEvent {
  id                 String            @id @default(uuid())
  tenantId           String
  machineId          String
  maintenanceOrderId String?
  breakdownId        String?
  actorId            String
  reason             String
  notes              String?
  idempotencyKey     String
  returnedAt         DateTime          @default(now())
  machine            Machine           @relation(fields: [machineId, tenantId], references: [id, tenantId], onDelete: Restrict)
  maintenanceOrder   MaintenanceOrder? @relation(fields: [maintenanceOrderId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actor              User              @relation(fields: [actorId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, machineId, returnedAt])
}

/// Faz I Energy Monitoring: makine bazında manuel enerji tüketim kaydı (sayaç
/// okuma/fatura girişi gibi) — otomatik telemetri henüz yok (connector kwh
/// göndermiyor), Calibration/SpcMeasurement'la aynı "manuel giriş" deseni.
model EnergyReading {
  id          String   @id @default(uuid())
  tenantId    String
  machineId   String
  kwh         Decimal  @db.Decimal(18, 3)
  recordedAt  DateTime @default(now())
  notes       String?
  createdById String
  createdAt   DateTime @default(now())

  machine   Machine @relation(fields: [machineId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([tenantId, machineId])
  @@index([tenantId, recordedAt])
}

/// Faz J Developer Platform: dış sistemlere olay bildirimi — mevcut
/// RealtimeGateway.emitToTenant() çağrı noktalarının tamamı otomatik olarak
/// webhook kaynağı olur (bkz. RealtimeGateway). Cron/kuyruk yok, teslim
/// fire-and-forget; lastStatus sadece görünürlük içindir, tam teslim geçmişi
/// tutulmaz (MVP kapsamı — retry/backoff yok).
model WebhookSubscription {
  id              String    @id @default(uuid())
  tenantId        String
  url             String
  /// Tam olay adı (örn. "workorder.updated") veya tüm olaylar için "*".
  event           String
  /// Ayarlanmışsa X-Webhook-Signature header'ında HMAC-SHA256 imzası gönderilir.
  secret          String?
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  lastStatus      String?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([tenantId, event])
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  DEAD_LETTER
}

/// Kalıcı webhook teslim kuyruğu. Olay zarfı ilk kayıtta dondurulur; retry'larda
/// aynı gövde ve HMAC imzası kullanılır. subscriptionId FK değildir: abonelik
/// silinse dahi teslim geçmişi denetlenebilir kalır.
model WebhookDeliveryEvent {
  id             String                @id @default(uuid())
  tenantId       String
  subscriptionId String
  /// Aynı domain olayı aynı abonelik için tekrar kuyruklanmasın diye idempotency anahtarı.
  eventId        String
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now())
  lockedUntil    DateTime?
  lastError      String?
  occurredAt     DateTime              @default(now())
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([subscriptionId, eventId])
  @@index([status, nextAttemptAt])
  @@index([tenantId, status, occurredAt])
  @@index([subscriptionId])
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  DISPATCHED
  DEAD_LETTER
}

/// AHK-009: domain yazımıyla AYNI transaction'da yazılan genel event outbox.
/// OutboxService.record() sadece Prisma.TransactionClient alır — bu yüzden bir
/// event, onu doğuran domain mutasyonuyla ya birlikte commit olur ya da hiç
/// olmaz. OutboxDispatcherService (WebhookDeliveryEvent ile aynı claim+backoff
/// deseni) bu satırları ayrı bir worker'da en-az-bir-kez tüketip
/// RealtimeGateway.emitToTenant + webhook enqueue'a çevirir.
model OutboxEvent {
  id            String            @id @default(uuid())
  tenantId      String
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  nextAttemptAt DateTime          @default(now())
  lockedUntil   DateTime?
  lastError     String?
  occurredAt    DateTime          @default(now())
  dispatchedAt  DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, nextAttemptAt])
  @@index([tenantId, status, occurredAt])
  @@index([aggregateType, aggregateId])
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

/// Faz L: Project Management — WorkOrder'dan bağımsız, üretim dışı proje
/// takibi (örn. bir makine kurulumu, bir müşteri özel projesi). Scheduling.tsx'in
/// basit Gantt deseniyle tutarlı: kapasite planlama algoritması yok, manuel
/// tarih/durum takibi.
model Project {
  id        String        @id @default(uuid())
  tenantId  String
  code      String
  name      String
  status    ProjectStatus @default(PLANNED)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tasks ProjectTask[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// WBS (Work Breakdown Structure) — self-referencing tek seviye değil,
/// gerçek ağaç (parentTaskId), Lot/SerialNumber'daki polimorfik desenden
/// farklı olarak burada gerçek bir hiyerarşi gerekiyordu.
model ProjectTask {
  id           String            @id @default(uuid())
  tenantId     String
  projectId    String
  parentTaskId String?
  name         String
  assigneeId   String?
  startDate    DateTime?
  endDate      DateTime?
  status       ProjectTaskStatus @default(TODO)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  project     Project            @relation(fields: [projectId], references: [id])
  parentTask  ProjectTask?       @relation("ProjectTaskParent", fields: [parentTaskId], references: [id])
  childTasks  ProjectTask[]      @relation("ProjectTaskParent")
  assignee    User?              @relation(fields: [assigneeId], references: [id])
  timeEntries ProjectTimeEntry[]

  @@index([tenantId, projectId])
}

/// Labor Tracking'in (Faz H) ProjectTask tarafındaki eşdeğeri — ayrı bir
/// Timesheet/clock-in modeli değil, görev başına basit saat girişi.
/// GET /projects/:id/cost bunu User.hourlyRate ile çarpıp work-orders.cost()'un
/// "partial" desenini izler (hourlyRate girilmemiş kullanıcılarda sessizce
/// atlanmaz, kullanıcıya görünür bir uyarı döner).
model ProjectTimeEntry {
  id        String   @id @default(uuid())
  tenantId  String
  taskId    String
  userId    String
  hours     Decimal  @db.Decimal(10, 2)
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  task ProjectTask @relation(fields: [taskId], references: [id])
  user User        @relation(fields: [userId], references: [id])

  @@index([tenantId, taskId])
}

enum LeadStatus {
  NEW
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

enum OpportunityStage {
  NEW
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

/// Faz M: gerçek CRM'in ilk parçası — henüz Customer olmayan potansiyel kontak.
/// convert() Quote.convert() → SalesOrder deseniyle aynı mantık: tek yönlü,
/// geri alınamaz bir dönüşüm, yeni bir Customer kaydı üretir.
model Lead {
  id                  String     @id @default(uuid())
  tenantId            String
  companyName         String
  contactName         String?
  email               String?
  phone               String?
  source              String?
  status              LeadStatus @default(NEW)
  convertedCustomerId String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  convertedCustomer Customer? @relation(fields: [convertedCustomerId], references: [id])

  @@index([tenantId])
}

/// Mevcut Customer'a bağlı satış fırsatı — CustomerNote'un (aktivite zaman
/// çizelgesi) yanında, customers.tsx'e gömülü ikinci bir panel olarak sunulur,
/// ayrı bir NAV sayfası açılmadı (opportunities "customers" sayfa iznini kullanır).
model Opportunity {
  id                String           @id @default(uuid())
  tenantId          String
  customerId        String
  title             String
  stage             OpportunityStage @default(NEW)
  estimatedValue    Decimal?         @db.Decimal(18, 2)
  expectedCloseDate DateTime?
  wonAt             DateTime?
  lostAt            DateTime?
  lostReason        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId, customerId])
}

enum ServiceTicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum ServiceTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// Faz N: Service Management'ın ilk parçası — MaintenanceOrder'ın (dahili,
/// makine bazlı bakım) müşteri tarafındaki eşdeğeri: bir müşteriden gelen
/// servis/şikayet talebi. NonConformance.resolve() ile aynı desen — RESOLVED'a
/// geçerken çözüm notu zorunlu.
model ServiceTicket {
  id             String                @id @default(uuid())
  tenantId       String
  customerId     String
  subject        String
  description    String?
  priority       ServiceTicketPriority @default(MEDIUM)
  status         ServiceTicketStatus   @default(OPEN)
  resolutionNote String?
  resolvedAt     DateTime?
  createdById    String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([tenantId, customerId])
  @@index([tenantId, status])
}

/// Faz O: SSO/OIDC — LdapConfig'e paralel (bkz. o modelin yorumu), ama
/// @@unique([tenantId]) YOK: kullanıcı en geniş seçeneği ("çoklu sağlayıcı")
/// seçti, aynı tenant'ta birden fazla OidcProvider satırı olabilir (örn. hem
/// Azure AD hem Google Workspace). clientSecretEnc, LdapConfig.bindPasswordEnc
/// ile aynı AES-256-GCM şemasını (common/crypto.ts) kullanır.
/// Güvenlik incelemesi düzeltmesi: discovery belgesi (authorization/token/jwks
/// endpoint'leri) artık HER GİRİŞTE değil, sadece sağlayıcı OLUŞTURULURKEN bir
/// kez çekilip burada SABİTLENİR (LdapConfig'in "test-connection" deseniyle
/// tutarlı — ADMIN, oluşturma anında gördüğü endpoint'leri zımnen onaylamış
/// olur). İlk tasarım "endpoint host'u issuer host'uyla aynı olmalı" kontrolü
/// içeriyordu; gerçek bir IdP'ye (Google) karşı test edilince bunun YANLIŞ
/// olduğu ortaya çıktı — Google'ın gerçek token_endpoint'i
/// oauth2.googleapis.com'da, jwks_uri'si www.googleapis.com'da, issuer ise
/// accounts.google.com'da (üçü FARKLI host, hepsi meşru). Pinleme, hem bu
/// yanlış pozitifi ortadan kaldırır hem de asıl riski (sonradan değişen/ele
/// geçirilmiş bir discovery yanıtının client_secret'i farklı bir host'a
/// sızdırması) host eşleştirmesinden daha güvenilir şekilde kapatır.
model OidcProvider {
  id                    String   @id @default(uuid())
  tenantId              String
  /// Login sayfasındaki "X ile giriş yap" butonunun etiketi.
  name                  String
  /// örn. https://login.microsoftonline.com/{tenant}/v2.0 — sadece oluşturma
  /// anında discovery için kullanılır, id_token doğrulamasında issuer claim'iyle
  /// karşılaştırılır.
  issuer                String
  authorizationEndpoint String
  tokenEndpoint         String
  jwksUri               String
  clientId              String
  clientSecretEnc       String
  scope                 String   @default("openid email profile")
  /// id_token claim'lerinden hangisi kullanıcı email'i olarak kullanılacak.
  emailClaim            String   @default("email")
  defaultRole           Role     @default(OPERATOR)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users User[]

  @@unique([tenantId, name])
  @@index([tenantId])
}
