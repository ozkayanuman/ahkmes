{
  "name": "ahkmes",
  "version": "0.1.0",
  "private": true,
  "description": "AHKMES — CNC talaşlı imalat için MES/hafif-ERP (Faz 0: makine bağlantısız uçtan uca akış)",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "node scripts/run-e2e.mjs",
    "typecheck": "pnpm -r typecheck",
    "dev:backend": "pnpm --filter @ahkmes/backend start:dev",
    "dev:web": "pnpm --filter @ahkmes/web dev"
  },
  "engines": {
    "node": ">=20"
  }
}
