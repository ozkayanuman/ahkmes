# AHKMES ortam değişkenleri — kopyala: cp .env.example .env
# Postgres
POSTGRES_USER=ahkmes
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ahkmes
DATABASE_URL=postgresql://ahkmes:change-me@localhost:5432/ahkmes?schema=public

# Backend
BACKEND_PORT=3000
JWT_SECRET=change-me-min-32-chars-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Seed (ilk kurulumda oluşturulacak admin kullanıcı)
SEED_ADMIN_EMAIL=admin@ahkmes.local
SEED_ADMIN_PASSWORD=change-me

# Web
VITE_API_URL=http://localhost:3000
