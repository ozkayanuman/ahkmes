# AHKMES ortam değişkenleri — kopyala: cp .env.example .env
# Postgres
POSTGRES_USER=ahkmes
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=ahkmes
DATABASE_URL=postgresql://ahkmes:change-me@localhost:5432/ahkmes?schema=public

# Backend
NODE_ENV=production
BACKEND_PORT=3000
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=https://mes.example.internal
PUBLIC_APP_URL=https://api.mes.example.internal
PUBLIC_WEB_URL=https://mes.example.internal
APP_VERSION=local
BUILD_SHA=unknown

# Seed (ilk kurulumda oluşturulacak admin kullanıcı)
# Demo seed is intentionally not used by production Compose. It requires
# SEED_MODE=demo and is only for disposable development/test databases.
SEED_ADMIN_EMAIL=admin@ahkmes.local
SEED_ADMIN_PASSWORD=development-only-demo-password

# MinIO (STEP / Work Instruction dosya deposu)
MINIO_ROOT_USER=ahkmes
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
MINIO_BUCKET=ahkmes-documents
# Backend konteynerinin dosya iceriginde kullandigi ic adres (docker-compose ag adi)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# Signed URL'lerin tarayicidan erisilebilir olmasi icin disaridan gorunen adres
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000

# SSO/OIDC — IdP'nin tarayıcıyı geri yönlendireceği dışarıdan görünen adresler
# (MINIO_PUBLIC_ENDPOINT ile aynı felsefe). Belirtilmezse localhost'a düşer.
# One-time customer provisioning. This command never creates sample machines,
# work orders, customers or users other than the explicit initial admin.
BOOTSTRAP_TENANT_NAME=Example Manufacturing Ltd
BOOTSTRAP_TENANT_CODE=example-manufacturing
BOOTSTRAP_ADMIN_EMAIL=admin@example.internal
BOOTSTRAP_ADMIN_PASSWORD=replace-with-unique-admin-password
BOOTSTRAP_ADMIN_NAME=Initial Administrator
BOOTSTRAP_PLANT_NAME=Main Plant
BOOTSTRAP_PLANT_CODE=MAIN
BOOTSTRAP_LOCALE=tr
BOOTSTRAP_TIMEZONE=Europe/Istanbul
BOOTSTRAP_EDITION=PROFESSIONAL
# Optional comma-separated ProductModule list; empty selects the documented
# CNC Manufacturing Professional legacy-module baseline.
BOOTSTRAP_LEGACY_MODULES=

# Web
VITE_API_URL=http://localhost:3000

# Connector (opsiyonel — sadece 'docker compose --profile connector up' ile başlar)
# Makine kaydı oluşturulduğunda backend'in verdiği connector key'i buraya yazılır.
CONNECTOR_ADAPTER=simulator
CONNECTOR_MACHINE_ID=
CONNECTOR_MACHINE_KEY=
CONNECTOR_OPCUA_ENDPOINT_URL=
CONNECTOR_M80_HOST=
CONNECTOR_M80_PORT=683
CONNECTOR_FANUC_HOST=
CONNECTOR_FANUC_PORT=8193
# Connector olay kuyruğu: Docker profilinde /var/lib/ahkmes altındaki kalıcı volume'a yazılır.
CONNECTOR_DURABLE_QUEUE_PATH=/var/lib/ahkmes/edge.queue.json
# Connector sağlık ve Prometheus metrikleri yalnızca container loopback'inde açılır.
CONNECTOR_HEALTH_PORT=9464
